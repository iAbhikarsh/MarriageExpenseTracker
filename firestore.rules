rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasTrackerAccess() {
      let profilePath = /databases/$(database)/documents/marriage_users/$(request.auth.uid);
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(profilePath)
        && get(profilePath).data.email == request.auth.token.email
        && get(profilePath).data.role in ['reader', 'editor'];
    }

    function isEditor() {
      let profilePath = /databases/$(database)/documents/marriage_users/$(request.auth.uid);
      return hasTrackerAccess()
        && get(profilePath).data.role == 'editor';
    }

    match /marriage_expenses/{documentId} {
      allow read: if hasTrackerAccess();
      allow write: if isEditor();
    }

    match /marriage_categories/{documentId} {
      allow read: if hasTrackerAccess();
      allow write: if isEditor();
    }

    match /marriage_settings/{documentId} {
      allow read: if hasTrackerAccess();
      allow write: if isEditor();
    }

    match /marriage_users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}